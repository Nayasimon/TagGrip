# ===== Unity =====
# Patterns have no leading slash, so they work whether the Unity project
# is at the repo root or in a subfolder (e.g. TagGrip-Unity/).
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset Store tools / plugins
**/Assets/AssetStoreTools*
**/Assets/Plugins/Editor/JetBrains*

# Auto-generated by IDEs
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta files for ignored stuff
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables / burst
**/Assets/AddressableAssetsData/*/*.bin*
**/Assets/StreamingAssets/aa.meta
**/Assets/StreamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini
